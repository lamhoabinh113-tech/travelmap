<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bỏ qua nếu là file hoặc thư mục thật ở thư mục gốc (như uploads/)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # CASE 1: Chạy ở local (nếu url chứa /travel-memory-map/)
    RewriteCond %{REQUEST_URI} ^/travel-memory-map/ [NC]
    RewriteRule ^(.*)$ /travel-memory-map/public/$1 [L]

    # CASE 2: Chạy ở production (nằm ngay ở gốc tên miền /)
    RewriteCond %{REQUEST_URI} !^/travel-memory-map/ [NC]
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>
