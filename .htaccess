<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bắt buộc HTTPS trên môi trường production (không áp dụng cho localhost)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^localhost$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Bỏ qua nếu là file hoặc thư mục thật ở thư mục gốc (như uploads/)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # CASE 1: Chạy ở local (nếu url chứa /travel-memory-map/)
    RewriteCond %{REQUEST_URI} ^/travel-memory-map/ [NC]
    RewriteRule ^(.*)$ /travel-memory-map/public/$1 [L]

    # CASE 2: Chạy ở production (nằm ngay ở gốc tên miền /)
    RewriteCond %{REQUEST_URI} !^/travel-memory-map/ [NC]
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>
